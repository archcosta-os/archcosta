" General
set nocompatible
syntax on
set number
set relativenumber
set cursorline
set showmatch

" Indentation
set tabstop=4
set shiftwidth=4
set expandtab
set autoindent
set smartindent

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" Colors
set background=dark
set termguicolors
colorscheme desert
